```env
PORT=10000

# Your Render URL
PUBLIC_SITE_URL=https://your-service.onrender.com

# Copy the complete "address" value from your GatePay checkout link.
# Do not use the shortened display version.
GATEPAY_ADDRESS=

# GatePay checkout settings
GATEPAY_CURRENCY=GBP
GATEPAY_PROVIDER=hosted

# Optional email settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional AI support email
AI_SUPPORT_EMAIL=dees123457@gmail.com
```
